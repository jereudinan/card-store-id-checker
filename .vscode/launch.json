{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "전체 앱 디버깅",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vinext/dist/cli.js",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s/forum/",
        "action": "debugWithEdge"
      }
    },
    {
      "name": "브라우저만 디버깅",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000/forum/",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "현재 Node 프로세스에 연결",
      "type": "node",
      "request": "attach",
      "processId": "${command:PickProcess}",
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
